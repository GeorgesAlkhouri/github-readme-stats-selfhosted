{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],

  "enabledManagers": ["dockerfile", "custom.regex", "github-actions"],
  "platformAutomerge": true,
  "customManagers": [
    {
      "customType": "regex",

      "managerFilePatterns": ["/Dockerfile$/"],

      "matchStrings": ["ARG GSE_REF=(?<currentDigest>[a-f0-9]{40})"],

      "datasourceTemplate": "git-refs",
      "depNameTemplate": "github-stats-extended",
      "packageNameTemplate": "https://github.com/stats-organization/github-stats-extended",

      "currentValueTemplate": "release",
      "versioningTemplate": "git"
    }
  ],

  "packageRules": [
    {
      "matchManagers": ["custom.regex"],
      "matchDepNames": ["github-stats-extended"],
      "groupName": "github-stats-extended upstream ref",
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "matchManagers": ["dockerfile"],
      "matchPackageNames": ["node"],
      "groupName": "node base image",
      "rangeStrategy": "bump",
      "allowedVersions": "24.x",
      "automerge": true,
      "automergeType": "pr"
    }
  ]
}
